							"var template = `",
							"<h2 style=\"font-family: Arial, sans-serif; color: #003087; text-align: center;\">PayPal Response Summary</h2>",
							"<div style=\"display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; margin-bottom: 20px;\">",
							"    <div style=\"background: linear-gradient(135deg, #003087, #009cde); color: white; padding: 20px; border-radius: 10px; text-align: center; min-width: 150px;\">",
							"        <div style=\"font-size: 32px; font-weight: bold;\">{{statusCode}}</div>",
							"        <div style=\"font-size: 14px;\">Status Code</div>",
							"    </div>",
							"    <div style=\"background: linear-gradient(135deg, #009cde, #00b4d8); color: white; padding: 20px; border-radius: 10px; text-align: center; min-width: 150px;\">",
							"        <div style=\"font-size: 32px; font-weight: bold;\">{{responseTime}}</div>",
							"        <div style=\"font-size: 14px;\">Response Time (ms)</div>",
							"    </div>",
							"    <div style=\"background: linear-gradient(135deg, #00b4d8, #48cae4); color: white; padding: 20px; border-radius: 10px; text-align: center; min-width: 150px;\">",
							"        <div style=\"font-size: 32px; font-weight: bold;\">{{responseSize}}</div>",
							"        <div style=\"font-size: 14px;\">Response Size (KB)</div>",
							"    </div>",
							"    <div style=\"background: linear-gradient(135deg, #48cae4, #90e0ef); color: #003087; padding: 20px; border-radius: 10px; text-align: center; min-width: 150px;\">",
							"        <div style=\"font-size: 32px; font-weight: bold;\">{{headerCount}}</div>",
							"        <div style=\"font-size: 14px;\">Headers Count</div>",
							"    </div>",
							"</div>",
							"<canvas id=\"responseChart\" height=\"100\"></canvas>",
							"<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js\"></script>",
							"<script>",
							"    var ctx = document.getElementById(\"responseChart\");",
							"    var chart = new Chart(ctx, {",
							"        type: \"bar\",",
							"        data: {",
							"            labels: [\"Status Code\", \"Response Time (ms)\", \"Response Size (KB)\", \"Headers Count\"],",
							"            datasets: [{",
							"                label: \"Response Metrics\",",
							"                data: [],",
							"                backgroundColor: [\"#003087\", \"#009cde\", \"#00b4d8\", \"#48cae4\"],",
							"                borderColor: [\"#002060\", \"#007ab8\", \"#0096c7\", \"#38b6d4\"],",
							"                borderWidth: 2",
							"            }]",
							"        },",
							"        options: {",
							"            legend: { display: false },",
							"            title: {",
							"                display: true,",
							"                text: \"Response Metrics Overview\",",
							"                fontSize: 16",
							"            },",
							"            scales: {",
							"                yAxes: [{",
							"                    ticks: { beginAtZero: true },",
							"                    scaleLabel: {",
							"                        display: true,",
							"                        labelString: \"Value\"",
							"                    }",
							"                }],",
							"                xAxes: [{",
							"                    scaleLabel: {",
							"                        display: true,",
							"                        labelString: \"Metric\"",
							"                    }",
							"                }]",
							"            }",
							"        }",
							"    });",
							"",
							"    pm.getData(function (err, value) {",
							"        chart.data.datasets[0].data = [",
							"            value.statusCode,",
							"            value.responseTimeRaw,",
							"            value.responseSizeRaw,",
							"            value.headerCount",
							"        ];",
							"        chart.update();",
							"    });",
							"</script>",
							"<div style=\"margin-top: 20px; font-family: Arial, sans-serif;\">",
							"    <h3 style=\"color: #003087;\">Response Headers</h3>",
							"    <table style=\"width: 100%; border-collapse: collapse;\">",
							"        <tr style=\"background-color: #003087; color: white;\">",
							"            <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Header</th>",
							"            <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Value</th>",
							"        </tr>",
							"        {{#each headers}}",
							"        <tr style=\"background-color: {{rowColor}};\">",
							"            <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">{{key}}</td>",
							"            <td style=\"padding: 8px; border: 1px solid #ddd; word-break: break-all;\">{{value}}</td>",
							"        </tr>",
							"        {{/each}}",
							"    </table>",
							"</div>",
							"`;",
							"",
							"function constructVisualizerPayload() {",
							"    var responseSize = pm.response.size().body;",
							"    var responseSizeKB = (responseSize / 1024).toFixed(2);",
							"    var headers = [];",
							"    var headerCount = 0;",
							"    ",
							"    pm.response.headers.each(function(header, index) {",
							"        headerCount++;",
							"        headers.push({",
							"            key: header.key,",
							"            value: header.value,",
							"            rowColor: index % 2 === 0 ? \"#f8f9fa\" : \"#ffffff\"",
							"        });",
							"    });",
							"    ",
							"    return {",
							"        statusCode: pm.response.code,",
							"        responseTime: pm.response.responseTime,",
							"        responseTimeRaw: pm.response.responseTime,",
							"        responseSize: responseSizeKB,",
							"        responseSizeRaw: parseFloat(responseSizeKB),",
							"        headerCount: headerCount,",
							"        headers: headers",
							"    };",
							"}",
							"",
							"pm.visualizer.set(template, constructVisualizerPayload());"
