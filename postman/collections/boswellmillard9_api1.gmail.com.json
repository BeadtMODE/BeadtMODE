							"    });",
							"</script>",
							"`;",
							"",
							"function constructVisualizerPayload() {",
							"    var responseSize = pm.response.text().length;",
							"    var responseSizeKB = (responseSize / 1024).toFixed(2);",
							"    var statusCode = pm.response.code;",
							"    var statusText = pm.response.status;",
							"    var responseTime = pm.response.responseTime;",
							"    var contentType = pm.response.headers.get(\"Content-Type\") || \"Not specified\";",
							"    var headerCount = pm.response.headers.count();",
							"    ",
							"    // Determine status color",
							"    var statusColor = \"#28a745\"; // green for 2xx",
							"    if (statusCode >= 300 && statusCode < 400) {",
							"        statusColor = \"#ffc107\"; // yellow for 3xx",
							"    } else if (statusCode >= 400) {",
							"        statusColor = \"#dc3545\"; // red for 4xx and 5xx",
							"    }",
							"    ",
							"    // Determine content format",
							"    var contentFormat = \"HTML\";",
							"    if (contentType.includes(\"json\")) {",
							"        contentFormat = \"JSON\";",
							"    } else if (contentType.includes(\"xml\")) {",
							"        contentFormat = \"XML\";",
							"    } else if (contentType.includes(\"text/plain\")) {",
							"        contentFormat = \"Plain Text\";",
							"    }",
							"    ",
							"    return {",
							"        statusCode: statusCode,",
							"        statusText: statusText,",
							"        statusColor: statusColor,",
							"        responseTime: responseTime,",
							"        responseSize: responseSize,",
							"        responseSizeKB: parseFloat(responseSizeKB),",
							"        contentType: contentType,",
							"        contentFormat: contentFormat,",
							"        headerCount: headerCount",
							"    };",
							"}",
							"",
							"pm.visualizer.set(template, constructVisualizerPayload());"
