							"    </div>",
							"</div>",
							"",
							"<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js\"></script>",
							"<script>",
							"    var ctx = document.getElementById(\"metadataChart\");",
							"    var metadataChart = new Chart(ctx, {",
							"        type: \"bar\",",
							"        data: {",
							"            labels: [\"Status Code\", \"Response Time (ms)\", \"Size (KB)\", \"Headers Count\"],",
							"            datasets: [{",
							"                label: \"Response Metrics\",",
							"                backgroundColor: [\"#003087\", \"#0070ba\", \"#00a0df\", \"#169bd7\"],",
