					"script": {
						"id": "20f4a7aa-b288-4f34-855d-8086e49c02ce",
						"exec": [
							"// Parse HTML response and extract metadata",
							"const responseBody = pm.response.text();",
							"const responseSize = responseBody.length;",
							"const statusCode = pm.response.code;",
							"",
							"// Count HTML elements using regex",
							"const metaTagsCount = (responseBody.match(/<meta[^>]*>/gi) || []).length;",
							"const scriptTagsCount = (responseBody.match(/<script[^>]*>/gi) || []).length;",
							"const linkTagsCount = (responseBody.match(/<link[^>]*>/gi) || []).length;",
							"",
							"// Extract title",
							"const titleMatch = responseBody.match(/<title[^>]*>([^<]*)<\\/title>/i);",
							"const pageTitle = titleMatch ? titleMatch[1].trim() : 'No title found';",
							"",
							"// Create visualization template",
							"var template = `",
							"<style>",
							"    .viz-container {",
							"        font-family: 'PayPal Sans', Arial, sans-serif;",
							"        padding: 20px;",
							"        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);",
							"        border-radius: 12px;",
							"        max-width: 800px;",
							"        margin: 0 auto;",
							"    }",
							"    .header {",
							"        text-align: center;",
							"        margin-bottom: 20px;",
							"    }",
							"    .header h2 {",
							"        color: #003087;",
							"        margin: 0 0 10px 0;",
							"    }",
							"    .header .title {",
							"        color: #666;",
							"        font-size: 14px;",
							"        word-break: break-word;",
							"    }",
							"    .status-badge {",
							"        display: inline-block;",
							"        padding: 8px 16px;",
							"        border-radius: 20px;",
							"        font-weight: bold;",
							"        margin: 10px 0;",
							"    }",
							"    .status-success {",
							"        background-color: #00a651;",
							"        color: white;",
							"    }",
							"    .status-error {",
							"        background-color: #d9534f;",
							"        color: white;",
							"    }",
							"    .stats-row {",
							"        display: flex;",
							"        justify-content: space-around;",
							"        flex-wrap: wrap;",
							"        margin: 20px 0;",
							"    }",
							"    .stat-card {",
							"        background: white;",
							"        border-radius: 8px;",
							"        padding: 15px 25px;",
							"        text-align: center;",
							"        box-shadow: 0 2px 8px rgba(0,0,0,0.1);",
							"        margin: 5px;",
							"        min-width: 120px;",
							"    }",
							"    .stat-value {",
							"        font-size: 28px;",
							"        font-weight: bold;",
							"        color: #003087;",
							"    }",
							"    .stat-label {",
							"        font-size: 12px;",
							"        color: #666;",
							"        text-transform: uppercase;",
							"    }",
							"    .chart-container {",
							"        background: white;",
							"        border-radius: 8px;",
							"        padding: 20px;",
							"        box-shadow: 0 2px 8px rgba(0,0,0,0.1);",
							"        margin-top: 20px;",
							"    }",
							"</style>",
							"",
							"<div class=\"viz-container\">",
							"    <div class=\"header\">",
							"        <h2>PayPal Response Analysis</h2>",
							"        <div class=\"title\">Page: {{pageTitle}}</div>",
							"        <div class=\"status-badge {{#if isSuccess}}status-success{{else}}status-error{{/if}}\">",
							"            Status: {{statusCode}}",
							"        </div>",
							"    </div>",
							"    ",
							"    <div class=\"stats-row\">",
							"        <div class=\"stat-card\">",
							"            <div class=\"stat-value\">{{responseSize}}</div>",
							"            <div class=\"stat-label\">Response Size (bytes)</div>",
							"        </div>",
							"        <div class=\"stat-card\">",
							"            <div class=\"stat-value\">{{metaTags}}</div>",
							"            <div class=\"stat-label\">Meta Tags</div>",
							"        </div>",
							"        <div class=\"stat-card\">",
							"            <div class=\"stat-value\">{{scriptTags}}</div>",
							"            <div class=\"stat-label\">Script Tags</div>",
							"        </div>",
							"        <div class=\"stat-card\">",
							"            <div class=\"stat-value\">{{linkTags}}</div>",
							"            <div class=\"stat-label\">Link Tags</div>",
							"        </div>",
							"    </div>",
							"    ",
							"    <div class=\"chart-container\">",
							"        <canvas id=\"htmlMetricsChart\" height=\"200\"></canvas>",
							"    </div>",
							"</div>",
							"",
							"<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js\"></script>",
							"<script>",
							"    var ctx = document.getElementById('htmlMetricsChart').getContext('2d');",
							"    ",
							"    pm.getData(function(err, value) {",
							"        var myChart = new Chart(ctx, {",
							"            type: 'bar',",
							"            data: {",
							"                labels: ['Meta Tags', 'Script Tags', 'Link Tags'],",
							"                datasets: [{",
							"                    label: 'HTML Element Count',",
							"                    data: [value.metaTags, value.scriptTags, value.linkTags],",
							"                    backgroundColor: [",
							"                        'rgba(0, 48, 135, 0.8)',",
							"                        'rgba(0, 166, 81, 0.8)',",
							"                        'rgba(255, 196, 57, 0.8)'",
							"                    ],",
							"                    borderColor: [",
							"                        'rgba(0, 48, 135, 1)',",
							"                        'rgba(0, 166, 81, 1)',",
							"                        'rgba(255, 196, 57, 1)'",
							"                    ],",
							"                    borderWidth: 2,",
							"                    borderRadius: 5",
							"                }]",
							"            },",
							"            options: {",
							"                responsive: true,",
							"                legend: {",
							"                    display: false",
							"                },",
							"                title: {",
							"                    display: true,",
							"                    text: 'HTML Elements Distribution',",
							"                    fontSize: 16,",
							"                    fontColor: '#003087'",
							"                },",
							"                scales: {",
							"                    yAxes: [{",
							"                        ticks: {",
							"                            beginAtZero: true,",
							"                            stepSize: 1",
							"                        },",
							"                        scaleLabel: {",
							"                            display: true,",
							"                            labelString: 'Count'",
							"                        }",
							"                    }],",
							"                    xAxes: [{",
							"                        scaleLabel: {",
							"                            display: true,",
							"                            labelString: 'Element Type'",
							"                        }",
							"                    }]",
							"                }",
							"            }",
							"        });",
							"    });",
							"</script>",
							"`;",
							"",
							"function constructVisualizerPayload() {",
							"    return {",
							"        statusCode: statusCode,",
							"        isSuccess: statusCode >= 200 && statusCode < 300,",
							"        responseSize: responseSize.toLocaleString(),",
							"        pageTitle: pageTitle,",
							"        metaTags: metaTagsCount,",
							"        scriptTags: scriptTagsCount,",
							"        linkTags: linkTagsCount",
							"    };",
							"}",
							"",
							"pm.visualizer.set(template, constructVisualizerPayload());"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
